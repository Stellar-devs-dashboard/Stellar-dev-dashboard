+}
+
+.diagnostic-preview-grid span,
+.diagnostic-compare-inputs span {
+  color: var(--text-muted);
+  font-size: 9px;
+  font-weight: 800;
+  text-transform: uppercase;
+}
+
+.diagnostic-preview-grid strong {
+  font-size: 18px;
+}
+
+.diagnostic-manifest {
+  margin-bottom: 15px;
+}
+
+.diagnostic-file-label {
+  position: relative;
+  cursor: pointer;
+}
+
+.diagnostic-file-label input {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  overflow: hidden;
+  clip: rect(0 0 0 0);
+  white-space: nowrap;
+  clip-path: inset(50%);
+}
+
+.diagnostic-compare-inputs {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 10px;
+  margin-top: 15px;
+}
+
+.diagnostic-compare-inputs strong {
+  overflow: hidden;
+  font-size: 11px;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.diagnostic-privacy-grid {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 10px;
+}
+
+.diagnostic-privacy-grid article {
+  padding: 13px;
+  border: 1px solid var(--border);
+  border-radius: 10px;
+  background: var(--bg-elevated);
+}
+
+.diagnostic-privacy-grid h3 {
+  margin: 10px 0 4px;
+}
+
+.diagnostic-pattern-form {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 11px;
+  align-items: end;
+  margin-bottom: 15px;
+}
+
+.diagnostic-skeleton-grid {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: 12px;
+}
+
+.diagnostic-skeleton-grid span {
+  min-height: 110px;
+  border-radius: 13px;
+  background: linear-gradient(90deg, var(--bg-card), var(--bg-elevated), var(--bg-card));
+  background-size: 200% 100%;
+  animation: diagnostic-shimmer 1.4s ease-in-out infinite;
+}
+
+@keyframes diagnostic-shimmer {
+  to {
+    background-position: -200% 0;
+  }
+}
+
+.diagnostic-dialog-backdrop {
+  position: fixed;
+  z-index: 1200;
+  inset: 0;
+  display: grid;
+  place-items: center;
+  padding: 18px;
+  background: rgba(0, 0, 0, 0.7);
+  backdrop-filter: blur(4px);
+}
+
+.diagnostic-dialog {
+  position: relative;
+  width: min(520px, 100%);
+  border-color: color-mix(in srgb, var(--red) 40%, var(--border)) !important;
+}
+
+.diagnostic-dialog-close {
+  position: absolute;
+  top: 10px;
+  right: 10px;
+  display: grid;
+  place-items: center;
+  width: 36px;
+  height: 36px;
+  border: 1px solid var(--border);
+  border-radius: 8px;
+  background: var(--bg-elevated);
+  color: var(--text-primary);
+  cursor: pointer;
+}
+
+@media (max-width: 900px) {
+  .diagnostic-metrics,
+  .diagnostic-preview-grid,
+  .diagnostic-skeleton-grid {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+
+  .diagnostic-flow-grid,
+  .diagnostic-control-grid {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+}
+
+@media (max-width: 640px) {
+  .diagnostic-hero,
+  .diagnostic-section-heading {
+    flex-direction: column;
+  }
+
+  .diagnostic-hero-status {
+    justify-content: flex-start;
+    min-width: 0;
+  }
+
+  .diagnostic-metrics,
+  .diagnostic-flow-grid,
+  .diagnostic-control-grid,
+  .diagnostic-two-column,
+  .diagnostic-preview-grid,
+  .diagnostic-compare-inputs,
+  .diagnostic-privacy-grid,
+  .diagnostic-pattern-form,
+  .diagnostic-skeleton-grid {
+    grid-template-columns: 1fr;
+  }
+
+  .diagnostic-check-list > li {
+    grid-template-columns: 28px minmax(0, 1fr);
+  }
+
+  .diagnostic-check-list .diagnostic-status-badge {
+    grid-column: 2;
+  }
+
+  .diagnostic-actions > button,
+  .diagnostic-actions > label,
+  .diagnostic-flow-card > button {
+    width: 100%;
+  }
+
+  .diagnostic-callout {
+    align-items: flex-start;
+    flex-direction: column;
+  }
+
+  .diagnostic-callout button {
+    width: 100%;
+    margin-left: 0;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .diagnostic-spinner,
+  .diagnostic-skeleton-grid span {
+    animation: none !important;
+  }
+
+  .diagnostic-actions button,
+  .diagnostic-flow-card button {
+    transition: none !important;
+    transform: none !important;
+  }
+}
+
+@media (forced-colors: active) {
+  .diagnostic-status-badge,
+  .diagnostic-check-control,
+  .diagnostic-flow-card,
+  .diagnostic-tabs button.active {
+    border: 1px solid CanvasText !important;
+  }
+}
