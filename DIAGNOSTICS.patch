+
+function validateBreadcrumb(value: unknown, index: number): void {
+  if (
+    !isRecord(value) ||
+    !hasOnlyKeys(value, [
+      'id',
+      'sequence',
+      'timestamp',
+      'action',
+      'feature',
+      'detail',
+      'correlationId',
+      'redactionCount',
+    ]) ||
+    !boundedString(value.id, 120) ||
+    !integerInRange(value.sequence, 0, Number.MAX_SAFE_INTEGER) ||
+    !validTimestamp(value.timestamp) ||
