+    !isRecord(value) ||
+    !hasOnlyKeys(value, [
+      'capturedAt',
+      'appVersion',
+      'buildMode',
+      'browserFamily',
+      'platformClass',
+      'language',
+      'timezone',
+      'viewport',
+      'online',
+      'cookieEnabled',
+      'storageEstimate',
+    ]) ||
+    !validTimestamp(value.capturedAt) ||
+    !boundedString(value.appVersion, 40) ||
+    !boundedString(value.buildMode, 40) ||
