{
  "name": "stellar-dev-dashboard",
  "version": "0.1.0",
  "description": "A real-time developer dashboard for the Stellar network",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "GITHUB_PAGES=true vite build && cp dist/index.html dist/404.html",
    "build:analyze": "ANALYZE=1 vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write package.json package-lock.json eslint.config.js tsconfig.json .github/workflows/ci.yml .prettierrc.json",
    "format:check": "prettier --check package.json package-lock.json eslint.config.js tsconfig.json .github/workflows/ci.yml .prettierrc.json",
    "type-check": "tsc --noEmit",
    "validate:i18n": "node scripts/validate-i18n.mjs",
    "test": "vitest run --config vitest.config.js",
    "test:watch": "vitest --config vitest.config.js",
    "test:ui": "vitest --ui --config vitest.config.js",
    "test:coverage": "vitest run --coverage --config vitest.config.js",
    "test:unit": "vitest run --config vitest.config.js --dir src",
    "test:integration": "vitest run --config vitest.config.js --dir tests/integration",
    "test:jest": "jest",
    "test:jest:coverage": "jest --coverage",
    "test:e2e": "playwright test --project=chromium --project=firefox --project=webkit --project=mobile-chrome",
    "test:e2e:analytics": "playwright test tests/e2e/behavior-analytics.spec.ts --project=chromium --workers=1",
    "test:e2e:critical": "playwright test tests/e2e/behavior-analytics.spec.ts tests/e2e/network-intelligence.spec.ts tests/e2e/market-sentiment.spec.ts tests/e2e/contract-testing.spec.ts tests/e2e/recommendations.spec.ts tests/e2e/diagnostics.spec.ts tests/e2e/ledger-snapshots.spec.ts --project=chromium --workers=1",
    "test:e2e:ui": "playwright test --ui",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "test:visual:report": "playwright show-report tests/e2e/report",
    "test:analytics-service": "npm test --prefix services/behavior-analytics",
    "test:network-monitor": "node --test services/network-monitor/server.test.mjs",
    "test:sentiment-service": "node --test services/sentiment-analysis/server.test.mjs",
    "test:fraud-service": "node --test services/fraud-detection/server.test.mjs",
    "test:recommendation-service": "node --test services/recommendation-engine/server.test.mjs",
    "test:contract-testing-service": "node --test services/contract-testing/server.test.mjs",
    "load:test:analytics": "k6 run services/behavior-analytics/load/k6.js",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "monitor:service": "node services/network-monitor/server.mjs",
    "sentiment:service": "node services/sentiment-analysis/server.mjs",
    "fraud:service": "node services/fraud-detection/server.mjs",
    "recommendation:service": "node services/recommendation-engine/server.mjs",
    "contract-testing:service": "node services/contract-testing/server.mjs"
  },
  "dependencies": {
    "@axe-core/react": "^4.11.3",
    "@stellar/stellar-sdk": "^12.3.0",
    "@tanstack/react-query": "^5.80.7",
    "@tanstack/react-query-devtools": "^5.80.7",
    "date-fns": "^3.6.0",
    "i18next": "^23.15.1",
    "i18next-browser-languagedetector": "^8.0.0",
    "idb": "^8.0.3",
    "jest-axe": "^10.0.0",
    "lucide-react": "^0.577.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-i18next": "^15.0.2",
    "react-router-dom": "^7.18.2",
    "recharts": "^2.12.7",
    "uuid": "^14.0.1",
    "zustand": "^4.5.4"
  },
  "optionalDependencies": {
    "@ledgerhq/hw-transport-webhid": "^6.29.4",
    "@ledgerhq/hw-transport-webusb": "^6.29.4",
    "@stellar/ledger": "^1.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@babel/preset-env": "^7.29.3",
    "@babel/preset-react": "^7.24.7",
    "@babel/preset-typescript": "^7.24.7",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-viewport": "^8.6.18",
    "@storybook/react-vite": "^8.5.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.5",
    "msw": "^2.14.3",
    "prettier": "^3.3.3",
    "rollup-plugin-visualizer": "^5.12.0",
    "storybook": "^8.5.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint",
    "*.{json,md,css,html,yml,yaml}": "prettier --check"
  }
}
